<section class="section container">
  <div style="max-width:480px;margin-inline:auto;">
    <h1 class="section__title" style="margin-bottom:.5rem;">Change Password</h1>
    <% if (forced) { %>
      <p style="color:var(--muted);text-align:center;margin-bottom:2rem;">
        You're using a temporary password. Set a new one to continue.
      </p>
    <% } %>
    <form class="form" action="/admin/change-password" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="password" name="current_password" placeholder="Current password"   autocomplete="current-password"  required />
      <input type="password" name="new_password"     placeholder="New password"        autocomplete="new-password"       required />
      <input type="password" name="confirm_password" placeholder="Confirm new password" autocomplete="new-password"      required />
      <p style="font-size:.85rem;color:var(--muted);">
        Min 12 chars · uppercase · lowercase · number
      </p>
      <button class="btn" type="submit" style="width:100%;margin-top:.5rem;">Update Password</button>
    </form>
    <% if (!forced) { %>
      <p style="text-align:center;margin-top:1.5rem;">
        <a href="/admin" style="color:var(--muted);font-size:.9rem;">← Back to dashboard</a>
      </p>
    <% } %>
  </div>
</section>