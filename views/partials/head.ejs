<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>JGM</title>
<link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
