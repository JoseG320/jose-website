<!-- INTRO / HERO -->
<section class="section container reveal">
  <div class="hero">
    <div class="hero__text">
      <p class="hero__eyebrow">Hello there. I am...</p>
      <h1 class="hero__name"><%= (settings && settings.display_name) || 'Your Name' %></h1>
      <p class="hero__bio"><%= (settings && settings.bio) || 'Editable bio from the admin panel here!' %></p>
      <div class="hero__actions">
        <% if (settings && settings.github_url) { %>
          <a class="btn" href="<%= settings.github_url %>" rel="noopener">GitHub</a>
        <% } %>
        <a class="btn" href="/resume">Resume</a>
      </div>
    </div>
    <div class="hero__photo">
      <!-- Replace this whole .placeholder div with: <img src="/img/portrait.jpg" alt="..."> -->
      <div class="placeholder"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/></svg></div>
    </div>
  </div>
</section>

<!-- ABOUT -->
<section id="about" class="section container reveal">
  <h2 class="section__title">About</h2>
  <div class="about__grid">
    <div>
      <h3 class="about__lead">Nice to meet you.</h3>
      <div class="placeholder"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/></svg></div>
    </div>
    <div class="about__body">
      <p>I'm <%= (settings && settings.display_name) || 'Your Name' %> — a developer who likes building clean, reliable web apps. <em>(Replace with your own story — what you build, what you're into, what you're looking for.)</em></p>
      <p>Right now I'm focused on sharpening my full-stack skills and looking for opportunities where I can build things people actually use.</p>
    </div>
  </div>
</section>

<!-- PROJECTS -->
<section id="projects" class="section container reveal">
  <h2 class="section__title">Projects</h2>

  <article class="project">
    <div class="project__media">
      <div class="placeholder"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/></svg></div>
      <h3 class="project__title">Project 1</h3>
      <p class="project__desc">Project short desc</p>
    </div>
    <div class="project__body">
      <p>A longer description of the project — what problem it solved, what you built, and what you learned. Keep the short label under the image and let this column carry the detail.</p>
    </div>
  </article>

  <article class="project">
    <div class="project__media">
      <div class="placeholder"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/></svg></div>
      <h3 class="project__title">Project 2</h3>
      <p class="project__desc">Project short desc</p>
    </div>
    <div class="project__body">
      <p>The image side alternates automatically row to row, so a list of projects has visual rhythm instead of feeling like a stack of identical blocks.</p>
    </div>
  </article>

  <article class="project">
    <div class="project__media">
      <div class="placeholder"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/></svg></div>
      <h3 class="project__title">Project 3</h3>
      <p class="project__desc">Project short desc</p>
    </div>
    <div class="project__body">
      <p>Add as many of these as you like. Later we can move projects into the database so you manage them from the admin panel instead of editing this file.</p>
    </div>
  </article>
</section>

<!-- CONTACT -->
<section id="contact" class="section container reveal">
  <h2 class="section__title">Contact</h2>
  <div class="contact__grid">
    <div>
      <h3 class="contact__lead">Let's work together.</h3>
      <div class="contact__text">
        <p>I'm currently seeking opportunities and would love to work with you on a project.</p>
        <% if (settings && settings.email) { %>
          <p>Reach me directly at <a href="mailto:<%= settings.email %>"><%= settings.email %></a>, or send a message using the form.</p>
        <% } else { %>
          <p>(Contact info here.) You can also send me a message using the form.</p>
        <% } %>
      </div>
    </div>
    <form class="form" action="/contact" method="post">
      <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><% } %>
      <div class="honeypot" aria-hidden="true"><label>Leave blank<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
      <input type="text" name="name" placeholder="Name" required />
      <input type="email" name="email" placeholder="Email" required />
      <input type="text" name="subject" placeholder="Subject" />
      <textarea name="message" placeholder="Message" required></textarea>
      <button class="btn" type="submit">Submit</button>
    </form>
  </div>
</section>
