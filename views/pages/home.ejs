<!-- CONTACT -->
<section id="contact" class="w-box c33xfh3 c1mzb2kd">
  <div class="w-box c1357293 c9jnjeu c5tmc3l c1ldum37 czr2pxy c155uc7w">
    <h2 class="w-heading c1dxq9cf c10r87ok c11dowh9 c32myit cwrra4i c1qom380">Contact</h2>
    <div class="pf-contact">
      <ul class="pf-contact__links">
        <% if (settings.email) { %><li><a href="mailto:<%= settings.email %>"><%= settings.email %></a></li><% } %>
        <% if (settings.github_url) { %><li><a href="<%= settings.github_url %>" rel="noopener">GitHub</a></li><% } %>
        <% if (settings.linkedin_url) { %><li><a href="<%= settings.linkedin_url %>" rel="noopener">LinkedIn</a></li><% } %>
      </ul>
      <form action="/contact" method="post" class="pf-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="pf-hp" aria-hidden="true"><label>Leave blank<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
        <label class="pf-field"><span>Name</span><input class="pf-input" type="text" name="name" required /></label>
        <label class="pf-field"><span>Email</span><input class="pf-input" type="email" name="email" required /></label>
        <label class="pf-field"><span>Message</span><textarea class="pf-input" name="message" rows="4" required></textarea></label>
        <button class="pf-btn" type="submit">Send message</button>
      </form>
    </div>
  </div>
</section>