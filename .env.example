# Enviroment
NODE_ENV=production

# App
PORT=3000
SITE_URL=http://localhost:3000
TRUST_PROXY=0

# Database: PostgreSQL
PGUSER=portfolio
PGPASSWORD=portfolio
PGDATABASE=portfolio
# NOTE:
# DATABASE_URL is assembled automatically in docker-compose; set it manually
# only if you run the app outside compose against an existing Postgres.
# DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio

# Session
# Generate a long random value. Use:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Admin (ONLY FOR FIRST TIME BOOT)
ADMIN_USERNAME=admin

# Uploads
UPLOAD_MAX_BYTES=5242880

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=your_site_key_here
TURNSTILE_SECRET_KEY=your_secret_key_here

# Resend
RESEND_API_KEY=re_KEYHERE
RESEND_FROM=onboarding@resend.dev
RESEND_TO=YOURMAILHERE
